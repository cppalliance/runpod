worker_processes 1;
error_log /dev/stderr warn;
pid /tmp/nginx.pid;

events {
    worker_connections 1024;
}

http {
    # Write temp files somewhere writable (not /var)
    client_body_temp_path /tmp/nginx_client_body;
    proxy_temp_path       /tmp/nginx_proxy;
    fastcgi_temp_path     /tmp/nginx_fastcgi;
    uwsgi_temp_path       /tmp/nginx_uwsgi;
    scgi_temp_path        /tmp/nginx_scgi;

    access_log /dev/stdout;

    server {
        listen 8000;

        location = /gpu-metrics {
            # ---- Auth check ----
            # /tmp/nginx_auth.conf is generated by the entrypoint. It defines
            # $expected1..$expectedN (N = number of accepted API keys), computes
            # $auth_ok, and rejects the request with 401 when it is 0.
            include /tmp/nginx_auth.conf;

            proxy_pass http://127.0.0.1:9400/metrics;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_read_timeout 30s;
        }

        # ---- Brave Search MCP ----
        # One shared Brave key lives in this pod; developers authenticate to
        # nginx with their personal API_KEY (via /tmp/nginx_auth.conf), and
        # nginx strips that credential before forwarding to the loopback MCP
        # server (http://127.0.0.1:8080/mcp). MCP streamable-HTTP streams over
        # server-sent events, so buffering and connection reuse must be off.
        location /brave/mcp {
            include /tmp/nginx_auth.conf;

            proxy_pass         http://127.0.0.1:8080/mcp;
            proxy_http_version 1.1;
            proxy_set_header   Host          $host;
            proxy_set_header   Authorization "";   # don't leak dev tokens upstream
            proxy_set_header   Connection    "";
            proxy_buffering    off;                # MCP streams over SSE
            proxy_read_timeout 3600s;
        }

        location / {
            # ---- Auth check ----
            # Accept any of the configured Bearer tokens (see /tmp/nginx_auth.conf).
            include /tmp/nginx_auth.conf;

            # ---- Forward to vLLM on internal port ----
            proxy_pass         http://127.0.0.1:8001;
            proxy_set_header   Host              $host;
            proxy_set_header   X-Real-IP         $remote_addr;
            proxy_set_header   Authorization     $http_authorization;

            # vLLM streaming needs these
            proxy_buffering         off;
            proxy_read_timeout      600s;
            proxy_send_timeout      600s;
            chunked_transfer_encoding on;
        }
    }
}
