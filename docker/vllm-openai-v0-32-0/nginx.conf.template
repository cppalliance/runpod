worker_processes 1;
error_log /dev/stderr warn;
pid /tmp/nginx.pid;

events {
    worker_connections 1024;
}

http {
    # Write temp files somewhere writable (not /var)
    client_body_temp_path /tmp/nginx_client_body;
    proxy_temp_path       /tmp/nginx_proxy;
    fastcgi_temp_path     /tmp/nginx_fastcgi;
    uwsgi_temp_path       /tmp/nginx_uwsgi;
    scgi_temp_path        /tmp/nginx_scgi;

    access_log /dev/stdout;

    # Request body cap. nginx's default is 1 MB, which a chat request crosses
    # at ~250k tokens (Claude Code resends the whole conversation every turn),
    # so long sessions failed with HTTP 413 before reaching vLLM. 32 MB covers
    # a full 1M-token context plus some images; vLLM still enforces
    # --max-model-len on whatever gets through.
    client_max_body_size 32m;

    # Runtime DNS for the variable-based proxy_pass in /brave/api/ (and any
    # future variable proxy_pass). nginx does NOT read /etc/resolv.conf on its
    # own; this is what lets it resolve the Brave host at request time instead
    # of once at boot.
    resolver 8.8.8.8 1.1.1.1 valid=30s ipv6=off;

    server {
        listen 8000;

        # ---- Unauthenticated health check (Nagios, uptime monitors) ----
        # Deliberately NOT behind /tmp/nginx_auth.conf: a monitor should not
        # have to hold a developer key, and rotating keys must not break
        # monitoring. It is also not a static "ok" — auth_request asks vLLM's
        # /health first, so an unresponsive engine yields a 5xx instead of a
        # false green.
        #
        # The body comes from a file rather than `return 200 "ok"` because
        # `return` runs in the rewrite phase, which is BEFORE auth_request
        # (access phase), so it would answer without ever checking vLLM. The
        # file is baked into the image; see the Dockerfile.
        location = /healthz {
            auth_request /_vllm_health;
            access_log off;                     # polled every minute
            default_type text/plain;
            alias /usr/share/nginx/healthz.txt;
        }

        # Internal subrequest target for auth_request above. `internal` makes
        # it unreachable from clients; only the healthz check can call it.
        location = /_vllm_health {
            internal;
            proxy_pass            http://127.0.0.1:8001/health;
            proxy_pass_request_body off;
            proxy_set_header      Content-Length "";
            proxy_set_header      Authorization "";   # vLLM needs no credential
            # A wedged engine must read as DOWN promptly rather than hold the
            # checker open. vLLM's /health is an engine round-trip: normally
            # milliseconds, so these are already generous.
            proxy_connect_timeout 2s;
            proxy_read_timeout    5s;
        }

        location = /gpu-metrics {
            # ---- Auth check ----
            # /tmp/nginx_auth.conf is generated by the entrypoint. It defines
            # $expected1..$expectedN (N = number of accepted API keys), computes
            # $auth_ok, and rejects the request with 401 when it is 0.
            include /tmp/nginx_auth.conf;

            proxy_pass http://127.0.0.1:9400/metrics;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_read_timeout 30s;
        }

        # ---- Brave Search REST API (for local website dev) ----
        # The wg21-paperflow site talks to Brave's REST API directly:
        #   GET https://api.search.brave.com/res/v1/web/search?q=...&count=...
        # with header "X-Subscription-Token: <key>". Developers point their
        # local copy at <pod>/brave/api instead; nginx accepts their *dev*
        # token here, discards it, and injects the real BRAVE_API_KEY on the
        # way upstream. The path /brave/api/web/search rewrites to
        # https://api.search.brave.com/res/v1/web/search via the proxy_pass.
        location /brave/api/ {
            # Accepts the pod key as either "Authorization: Bearer <key>" or
            # "X-Subscription-Token: <key>" (what real Brave clients send).
            include /tmp/nginx_auth_brave.conf;

            # Resolve api.search.brave.com at *request* time rather than once
            # at boot. A DNS hiccup during startup then can't abort nginx with
            # "[emerg] host not found in upstream". Using a variable in
            # proxy_pass disables nginx's config-time resolution, so we must
            # supply the Host header and SNI name explicitly (they would
            # otherwise be empty because $proxy_host is unset for variables).
            set $brave_upstream api.search.brave.com;

            # With a variable in proxy_pass, nginx does NOT replace the
            # location prefix: a URI there (e.g. https://$brave_upstream/res/v1/)
            # is sent verbatim for every request, dropping web/search and
            # Brave answers 301. Map the path with rewrite and give proxy_pass
            # no URI, so the rewritten path and query string pass through.
            rewrite ^/brave/api/(.*)$ /res/v1/$1 break;
            proxy_pass            https://$brave_upstream;
            proxy_ssl_server_name on;
            proxy_ssl_name        $brave_upstream;
            proxy_set_header      Host                 $brave_upstream;
            proxy_set_header      Authorization        "";   # drop dev auth
            proxy_set_header      X-Subscription-Token "${BRAVE_API_KEY}";
            proxy_read_timeout    30s;
        }

        # ---- Brave Search MCP ----
        # One shared Brave key lives in this pod; developers authenticate to
        # nginx with their personal API_KEY (via /tmp/nginx_auth.conf), and
        # nginx strips that credential before forwarding to the loopback MCP
        # server (http://127.0.0.1:8080/mcp). MCP streamable-HTTP streams over
        # server-sent events, so buffering and connection reuse must be off.
        location /brave/mcp {
            include /tmp/nginx_auth.conf;

            proxy_pass         http://127.0.0.1:8080/mcp;
            proxy_http_version 1.1;
            proxy_set_header   Host          $host;
            proxy_set_header   Authorization "";   # don't leak dev tokens upstream
            proxy_set_header   Connection    "";
            proxy_buffering    off;                # MCP streams over SSE
            proxy_read_timeout 3600s;
        }

        location / {
            # ---- Auth check ----
            # Accept any of the configured Bearer tokens (see /tmp/nginx_auth.conf).
            include /tmp/nginx_auth.conf;

            # ---- Forward to vLLM on internal port ----
            proxy_pass         http://127.0.0.1:8001;
            proxy_set_header   Host              $host;
            proxy_set_header   X-Real-IP         $remote_addr;
            proxy_set_header   Authorization     $http_authorization;

            # vLLM streaming needs these
            proxy_buffering         off;
            proxy_read_timeout      600s;
            proxy_send_timeout      600s;
            # Default is already chunked_transfer_encoding on;
            chunked_transfer_encoding on;
        }
    }
}
