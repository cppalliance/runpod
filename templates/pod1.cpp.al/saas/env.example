# /etc/nginx/saas.env  —  secrets & options for the SaaS failover vhost.
#
# Copy this file to /etc/nginx/saas.env and `chmod 600` it, then run render.sh.
#
# Format: KEY=VALUE, one per line. Full-line comments start with '#'.
# Do NOT use inline comments, and do NOT put nginx metacharacters in values
# (", $, ;) — keys never contain these, but be aware.
#
# ---------------------------------------------------------------------------
# Inbound auth: who may call pod1.cpp.al. Mirrors the pod's API_KEY..API_KEY25.
# ---------------------------------------------------------------------------
# Primary developer bearer token (required).
API_KEY=sk-dev-000___

# Optional additional developer tokens (revoke one person without rotating all).
#API_KEY2=
#API_KEY3=
# ... up to API_KEY25 ...

# ---------------------------------------------------------------------------
# Brave Search (shared key; backs /brave/api/ and, if enabled, /brave/mcp).
# ---------------------------------------------------------------------------
BRAVE_API_KEY=BSA-your-brave-search-key

# ---------------------------------------------------------------------------
# LLM provider keys (outbound). Set whichever provider(s) you may switch to.
# ---------------------------------------------------------------------------
# OpenRouter — https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=sk-or-v1-000___ 

# Anthropic — https://platform.claude.com/settings/workspaces/default/keys
ANTHROPIC_API_KEY=sk-ant-api03-000___ 

# Only needed if your Anthropic key has access to multiple workspaces.
#ANTHROPIC_WORKSPACE_ID=

# ---------------------------------------------------------------------------
# OpenRouter optional app-identity headers (used for its rankings page).
# ---------------------------------------------------------------------------
OPENROUTER_REFERER=https://pod1.cpp.al
OPENROUTER_TITLE=pod1.cpp.al
